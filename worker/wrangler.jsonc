{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clarion-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clarion",
      "database_id": "0a297b69-34b1-4e8f-8b30-afc59f6ae404"
    }
  ],
  "vars": {
    // ブラウザから叩けるオリジンを限定する。カンマ区切りで複数可。
    // ローカル開発時は "http://localhost:8123" などを一時的に足す。
    "ALLOWED_ORIGINS": "https://masaki-lunaless.github.io",

    // TTSプロバイダ: "openai" | "aivis" | "none"。
    // 既定はopenai（Whisper用のキーで鳴るので追加契約が要らない）。
    // 日本語の自然さを上げたくなったら "aivis" に変える。
    // 旧にじボイスは2026-02-04にサービス終了したため廃止。
    "TTS_PROVIDER": "openai",
    "TTS_SPEED": "1.0",

    // aivis: ダッシュボードで選んだモデルUUIDを既定の声にする
    "AIVIS_MODEL_UUID": "",
    // フロントの声選択に出す候補。"uuid:表示名,uuid:表示名" 形式
    "AIVIS_VOICES": "",

    // openai: 組み込みボイス名（alloy/ash/ballad/coral/echo/fable/nova/onyx/sage/shimmer/verse）
    "OPENAI_TTS_VOICE": "nova"
  }
  // secrets（wrangler secret put で設定、コードにもGitにも置かない）:
  //   ANTHROPIC_API_KEY   … Claude API
  //   OPENAI_API_KEY      … Whisper API（TTSにopenaiを使う場合は音声合成も兼ねる）
  //   AIVIS_API_KEY       … Aivis Cloud API（日本語ネイティブのTTSを使う場合）
  //   ACCESS_TOKENS       … "clientA:xxxx,clientB:yyyy" 形式。未設定だと誰でも叩けるので本番では必須
}
